# Public https address of THIS server. The QR code points here, and it is used in the review-email links.
PUBLIC_URL=https://YOUR-FIDARA-APP.example
PORT=3000
# Who receives the review requests (Charlotte / the review team)
REVIEW_TO=reviews@verdecasabrands.example
# Secret used to sign video links. Make it long and random.
LINK_SECRET=change-me-to-a-long-random-string
# Where videos are stored on disk (use a persistent disk) and how long to keep them
UPLOAD_DIR=./uploads
RETENTION_DAYS=90
# Behind Render / Railway / Fly / nginx keep 1 so the rate limit sees real visitor IPs. 0 = not behind a proxy.
TRUST_PROXY=1
# Only needed if the app pages are hosted on a DIFFERENT site than this server
SITE_ORIGIN=
# Email sending (SMTP). Leave SMTP_HOST empty to only print emails in the console (testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fidara <no-reply@verdecasabrands.example>"

# How many video reviews one customer email gets (one box = one review). Charlotte's intro promises 1.
REVIEWS_PER_BOX=1

# Where registration records are kept (one JSON line per sign-up). Use a persistent disk. Not touched by the retention sweep.
DATA_DIR=./data
# Optional: mirror every registration and review into a Google Sheet. See google-sheet.gs for the 2-minute setup.
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# Password for the team's CSV downloads: open https://YOUR-ADDRESS/admin/registrations.csv (and /admin/reviews.csv),
# enter any username and this password. Leave empty to switch the downloads off.
ADMIN_KEY=
# Optional: email every new Estoy Aqui sign-up (name, email, ZIP, puppy) to this address. Leave empty to send nothing.
ESTOY_AQUI_TO=
# Set to production on the live server to get warnings about placeholder settings.
NODE_ENV=

# Email every new sign-up (name, email, ZIP, puppy, consent time) to this address, so the team sees them as they happen.
SIGNUP_NOTIFY_TO=
