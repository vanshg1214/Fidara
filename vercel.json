{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/api/index.js" },
    { "source": "/v/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" }
  ]
}

